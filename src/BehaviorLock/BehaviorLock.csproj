<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Vadim Albarov</Authors>
    <Copyright>Copyright 2026 Vadim Albarov</Copyright>
    <Description>Active security for ASP.NET Core APIs. Records what each endpoint touches and blocks everything else.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/valbarov/BehaviorLock</PackageProjectUrl>
    <RepositoryUrl>https://github.com/valbarov/BehaviorLock</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- The public types are the ones that an app uses. The tests and the load test also use the rest. -->
  <ItemGroup>
    <InternalsVisibleTo Include="BehaviorLock.Tests" />
    <InternalsVisibleTo Include="BehaviorLock.LoadTest" />
  </ItemGroup>

  <!-- Each .NET version gets the EF Core of the same major version. The lowest patch, so the app chooses its own. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="11.0.0" />
  </ItemGroup>

</Project>
